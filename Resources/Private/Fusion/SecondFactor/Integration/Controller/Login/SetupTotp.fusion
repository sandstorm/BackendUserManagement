Sandstorm.BackendUserManagement.SecondFactor.LoginController.setupTotp = Sandstorm.BackendUserManagement:SecondFactor.Page.SetupPage {
    site = ${site}
    styles = ${styles}
    scripts = ${scripts}
    username = ${username}
    flashMessages = ${flashMessages}

    body = Sandstorm.BackendUserManagement:SecondFactor.Component.SetupTotpStep {
        secret = ${secret}
        qrCode = ${qrCode}
        targetAction = 'createSecondFactor'
    }
}
