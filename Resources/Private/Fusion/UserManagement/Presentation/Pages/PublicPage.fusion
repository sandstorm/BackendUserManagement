# Login box layout for the unauthenticated user management screens.
prototype(Sandstorm.BackendUserManagement:UserManagement.Page.PublicPage) < prototype(Sandstorm.BackendUserManagement:Page.LoginBoxPage) {
    site = ${site}
    styles = ${styles}
    flashMessages = ${flashMessages}
    footerAction = Sandstorm.BackendUserManagement:UserManagement.Component.BackToLoginLink
}
