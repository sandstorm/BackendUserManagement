prototype(Sandstorm.BackendUserManagement:UserManagement.Component.ForgotPasswordLink) < prototype(Neos.Fusion:Component) {
    enabled = ${Configuration.setting('Sandstorm.BackendUserManagement.userManagement.enabled')}

    requestUri = Neos.Fusion:UriBuilder {
        package = 'Sandstorm.BackendUserManagement'
        subpackage = 'UserManagement'
        controller = 'Password'
        action = 'request'
    }

    renderer = afx`
        <div @if={props.enabled} class="neos-user-management__forgot-password">
            <a href={props.requestUri} data-test-id="forgot-password-link">
                {I18n.id('login.forgotPassword').value('Forgot your password?').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}
            </a>
        </div>
    `
}
