Sandstorm.BackendUserManagement.UserManagement.ModuleController.confirmDelete = Sandstorm.BackendUserManagement:UserManagement.Page.ModulePage {
    @context.indexUri = Neos.Fusion:UriBuilder {
        action = 'index'
    }
    content = afx`
        <div class="neos-user-management">
            <legend>
                <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.delete.title"/>
            </legend>
            <p>
                <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.delete.text"/>
            </p>
            <ul class="neos-user-management__delete-list">
                <Neos.Fusion:Loop items={users} itemName="user">
                    <li>{String.htmlSpecialChars(user.displayName)} ({String.htmlSpecialChars(Array.join(user.accountIdentifiers, ', '))})</li>
                </Neos.Fusion:Loop>
            </ul>
            <Neos.Fusion.Form:Form form.target.action="delete"
                                   form.target.arguments={{userIds: Array.map(users, user => user.userId)}}>
                <div class="neos-footer">
                    <a href={indexUri} class="neos-button">
                        <Sandstorm.BackendUserManagement:UserManagement.Translate id="cancel"/>
                    </a>
                    <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-danger"
                                             attributes.data-test-id="confirm-delete">
                        <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.delete.confirm"/>
                    </Neos.Fusion.Form:Button>
                </div>
            </Neos.Fusion.Form:Form>
        </div>
    `
}
