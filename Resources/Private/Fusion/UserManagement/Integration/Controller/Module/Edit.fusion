Sandstorm.BackendUserManagement.UserManagement.ModuleController.edit = Sandstorm.BackendUserManagement:UserManagement.Page.ModulePage {
    @context.indexUri = Neos.Fusion:UriBuilder {
        action = 'index'
    }
    @context.userArguments = ${{userId: user.userId}}

    content = afx`
        <div class="neos-user-management" data-test-id="user-details">
            <legend>{String.htmlSpecialChars(user.displayName)}</legend>

            <section class="neos-user-management__section">
                <h2>
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.userData"/>
                </h2>
                <Neos.Fusion.Form:Form form.target.action="update" form.target.arguments={userArguments}
                                       form.data={user} attributes.class="neos-user-management__form">
                    <div class="neos-user-management__row" @if={usernameIsEmail}>
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField
                            labelId="field.username" for="username"
                            hint={I18n.id('module.edit.usernameHint').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}>
                            <input type="text" id="username" readonly value={Array.join(user.accountIdentifiers, ', ')}
                                   data-test-id="username"/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                    </div>
                    <div class="neos-user-management__row">
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField
                            labelId="field.firstName" for="firstName">
                            <Neos.Fusion.Form:Input field.name="firstName" attributes.id="firstName"
                                                    attributes.required={true}/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField
                            labelId="field.lastName" for="lastName">
                            <Neos.Fusion.Form:Input field.name="lastName" attributes.id="lastName"
                                                    attributes.required={true}/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField labelId="field.email"
                                                                                                  for="email"
                                                                                                  hint={I18n.id(usernameIsEmail ? 'module.edit.emailChangeHintUsernameIsEmail' : 'module.edit.emailChangeHint').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}
                        >
                            <Neos.Fusion.Form:Input field.name="email" field.value={user.primaryEmail}
                                                    attributes.id="email" attributes.type="email"
                                                    attributes.required={true} attributes.data-test-id="email"/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                        <div class="neos-control-group neos-user-management__inline-checkbox" @if={mayMarkEmailValidated}>
                            <label class="neos-checkbox neos-user-management__checkbox" for="markEmailValidated">
                                <Neos.Fusion.Form:Checkbox field.name="markEmailValidated" field.value="1"
                                                           attributes.id="markEmailValidated" attributes.checked={false}
                                                           attributes.data-test-id="mark-email-validated-on-save"/>
                                <span></span>
                                <span class="neos-user-management__checkbox-text">
                                    <Sandstorm.BackendUserManagement:UserManagement.Translate
                                        id="module.edit.markEmailValidatedOnSave"/>
                                </span>
                            </label>
                        </div>
                    </div>
                    <div class="neos-control-group neos-user-management__active" @if={!isSelf}>
                        <label class="neos-checkbox neos-user-management__checkbox" for="active">
                            <Neos.Fusion.Form:Checkbox field.name="active" field.value="1" attributes.id="active"
                                                       attributes.checked={user.active}/>
                            <span></span>
                            <Sandstorm.BackendUserManagement:UserManagement.Translate id="field.active"/>
                        </label>
                        <p class="neos-user-management__hint">
                            <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.activeHint"/>
                        </p>
                    </div>
                    <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary"
                                             attributes.data-test-id="save-user">
                        <Sandstorm.BackendUserManagement:UserManagement.Translate id="save"/>
                    </Neos.Fusion.Form:Button>
                </Neos.Fusion.Form:Form>
            </section>

            <section class="neos-user-management__section">
                <h2>
                    <Sandstorm.BackendUserManagement:UserManagement.Translate
                        id="module.edit.emailVerificationStatus"/>
                </h2>
                <p>
                    {user.primaryEmail ? String.htmlSpecialChars(user.primaryEmail) : '-'}
                    <Sandstorm.BackendUserManagement:UserManagement.Component.EmailBadge @if={user.primaryEmail}
                                                                                               approved={user.emailApproved}/>
                </p>
                <div class="neos-user-management__actions" @if={user.primaryEmail && !user.emailApproved}>
                    <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                        action="sendEmailVerification" arguments={userArguments} testId="send-email-verification"
                        label={I18n.id('module.edit.sendEmailVerification').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
                    <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                        @if={mayMarkEmailValidated}
                        action="markEmailValidated" arguments={userArguments} testId="mark-email-validated"
                        label={I18n.id('module.edit.markEmailValidated').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
                </div>
            </section>

            <section class="neos-user-management__section">
                <h2>
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="field.password"/>
                </h2>
                <div class="neos-user-management__actions">
                    <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                        action="sendPasswordMail" arguments={Array.set(userArguments, 'type', 'resetPassword')}
                        testId="send-reset-mail"
                        label={I18n.id('module.edit.sendResetMail').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
                    <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                        @if={user.accountWithoutPassword} action="sendPasswordMail"
                        arguments={Array.set(userArguments, 'type', 'initialPassword')} testId="send-initial-mail"
                        label={I18n.id('module.edit.sendInitialMail').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
                </div>
                <Neos.Fusion.Form:Form form.target.action="setPassword" form.target.arguments={userArguments}
                                       attributes.class="neos-user-management__form">
                    <div class="neos-user-management__row">
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField
                            labelId="field.password" for="password">
                            <Neos.Fusion.Form:Password field.name="password" attributes.id="password"
                                                       attributes.autocomplete="new-password" attributes.required={true}
                                                       attributes.minlength={passwordMinimumLength}/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                        <Sandstorm.BackendUserManagement:UserManagement.Component.FormField
                            labelId="field.passwordConfirmation" for="passwordConfirmation">
                            <Neos.Fusion.Form:Password field.name="passwordConfirmation"
                                                       attributes.id="passwordConfirmation"
                                                       attributes.autocomplete="new-password"
                                                       attributes.required={true}/>
                        </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
                    </div>
                    <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary">
                        <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.setPassword"/>
                    </Neos.Fusion.Form:Button>
                </Neos.Fusion.Form:Form>
            </section>

            <section class="neos-user-management__section">
                <h2>
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.accounts"/>
                </h2>
                <div class="neos-user-management__callout" @if={usernameIsEmail && !isSelf && user.emailApproved && Array.length(user.usernamesDifferentFromEmail) > 0}>
                    <p class="neos-user-management__hint">
                        <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.useEmailAsUsernameHint"
                                                                                        arguments={[String.htmlSpecialChars(user.primaryEmail)]}/>
                    </p>
                    <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                        action="useEmailAsUsername" arguments={userArguments} testId="use-email-as-username"
                        label={I18n.id('module.edit.useEmailAsUsername').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
                </div>
                <Neos.Fusion:Loop items={user.accounts} itemName="account" iterationName="accountIteration">
                    <Sandstorm.BackendUserManagement:UserManagement.Component.AccountEditor
                        account={account}
                        index={accountIteration.index}
                        userArguments={userArguments}
                        roles={roles}
                        canImpersonate={canImpersonate}
                    />
                </Neos.Fusion:Loop>
            </section>

            <section class="neos-user-management__section">
                <h2>
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="field.secondFactors"/>
                </h2>
                <p data-test-id="second-factor-count">
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.secondFactorCount"
                                                                                    arguments={[user.secondFactorCount]}/>
                </p>
                <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                    @if={user.secondFactorCount > 0} action="resetSecondFactors" arguments={userArguments}
                    testId="reset-second-factors" class="neos-button neos-button-warning"
                    label={I18n.id('module.edit.resetSecondFactors').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
            </section>

            <div class="neos-footer">
                <a href={indexUri} class="neos-button">
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="back"/>
                </a>
                <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton
                    @if={!isSelf}
                    action="confirmDelete"
                    arguments={{userIds: [user.userId]}}
                    testId="delete-user"
                    class="neos-button neos-button-danger"
                    label={I18n.id('module.edit.delete').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}/>
            </div>
        </div>
    `
}

prototype(Sandstorm.BackendUserManagement:UserManagement.Component.AccountEditor) < prototype(Neos.Fusion:Component) {
    account = null
    index = 0
    userArguments = ${{}}
    roles = ${[]}
    canImpersonate = false

    renderer = afx`
        <div class="neos-user-management__account" data-test-id="account">
            <h3>{String.htmlSpecialChars(props.account.accountIdentifier)} <small>({props.account.authenticationProviderName})</small></h3>
            <p class="neos-user-management__hint neos-user-management__account-meta">
                <Sandstorm.BackendUserManagement:UserManagement.Translate id="field.lastLogin" />: {props.account.lastSuccessfulAuthentication ? Date.format(props.account.lastSuccessfulAuthentication, 'Y-m-d H:i') : '-'}
            </p>
            <Neos.Fusion.Form:Form form.target.action="updateAccountRoles" form.target.arguments={Array.set(props.userArguments, 'accountId', props.account.accountId)}
                                   attributes.class="neos-user-management__form" attributes.id={'account-' + props.index + '-roles'}>
                <Sandstorm.BackendUserManagement:UserManagement.Component.FormField labelId="field.roles">
                    <Sandstorm.BackendUserManagement:UserManagement.Component.RoleCheckboxes roles={props.roles} selectedRoleIdentifiers={props.account.roleIdentifiers} idPrefix={'account-' + props.index + '-role'} />
                </Sandstorm.BackendUserManagement:UserManagement.Component.FormField>
            </Neos.Fusion.Form:Form>
            <div class="neos-user-management__actions">
                <button type="submit" form={'account-' + props.index + '-roles'} class="neos-button neos-button-primary" data-test-id="save-roles">
                    <Sandstorm.BackendUserManagement:UserManagement.Translate id="module.edit.saveRoles" />
                </button>
                <Sandstorm.BackendUserManagement:UserManagement.Component.ActionButton @if={props.canImpersonate && props.account.active}
                    action="impersonate" arguments={Array.set(props.userArguments, 'accountId', props.account.accountId)} testId="impersonate"
                    label={I18n.id('module.edit.impersonate').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()} />
            </div>
        </div>
    `
}
