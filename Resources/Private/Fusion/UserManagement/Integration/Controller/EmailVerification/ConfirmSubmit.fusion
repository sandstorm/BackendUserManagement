Sandstorm.BackendUserManagement.UserManagement.EmailVerificationController.confirmSubmit = Sandstorm.BackendUserManagement:UserManagement.Page.PublicPage {
    body = Sandstorm.BackendUserManagement:UserManagement.Component.PublicMessage {
        testId = ${confirmed ? 'email-confirmed' : 'link-invalid'}
        text = ${I18n.id(confirmed ? (newUsername ? 'email.confirm.successUsernameChanged' : 'email.confirm.success') : 'link.invalid').package('Sandstorm.BackendUserManagement').source('UserManagement').arguments([String.htmlSpecialChars(newUsername)]).translate()}
    }
}
