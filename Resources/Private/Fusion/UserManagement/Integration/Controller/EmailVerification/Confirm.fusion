Sandstorm.BackendUserManagement.UserManagement.EmailVerificationController.confirm = Sandstorm.BackendUserManagement:UserManagement.Page.PublicPage {
    body = Neos.Fusion:Case {
        invalid {
            condition = ${!valid}
            renderer = Sandstorm.BackendUserManagement:UserManagement.Component.PublicMessage {
                testId = 'link-invalid'
                text = ${I18n.id('link.invalid').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}
            }
        }
        form {
            condition = true
            # a button instead of confirming on GET, because mail scanners prefetch links
            renderer = afx`
                <Neos.Fusion.Form:Form form.target.action="confirmSubmit" form.target.arguments={{token: token}} attributes.class="neos-user-management__form">
                    <fieldset>
                        <p class="neos-backend-user-management__login-label">
                            {I18n.id('email.confirm.intro').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}
                        </p>
                        <div class="neos-actions">
                            <Neos.Fusion.Form:Button attributes.class="neos-button neos-login-btn" attributes.data-test-id="confirm-email">
                                {I18n.id('email.confirm.submit').package('Sandstorm.BackendUserManagement').source('UserManagement').translate()}
                            </Neos.Fusion.Form:Button>
                        </div>
                    </fieldset>
                </Neos.Fusion.Form:Form>
            `
        }
    }
}
