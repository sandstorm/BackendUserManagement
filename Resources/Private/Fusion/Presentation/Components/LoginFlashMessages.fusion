prototype(Sandstorm.BackendUserManagement:Component.LoginFlashMessages) < prototype(Neos.Fusion:Component) {
    flashMessages = ${[]}

    renderer = afx`
        <Neos.Fusion:Loop items={props.flashMessages} itemName="flashMessage">
            <div class={'neos-backend-user-management__flashmessage neos-backend-user-management__flashmessage--' + String.toLowerCase(flashMessage.severity)}>{String.htmlSpecialChars(flashMessage)}</div>
        </Neos.Fusion:Loop>
    `
}
