{
    "description": "Backend User Management Package for Neos, includes 2FA, password reset, new user management UI and more",
    "type": "neos-package",
    "name": "sandstorm/backendusermanagement",
    "license": [
        "MIT"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sandstorm/Sandstorm.NeosInitE2ETestsPlugin.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "neos/neos": "^8.0 | ^9.0",
        "neos/fusion": "*",
        "neos/fusion-afx": "*",
        "neos/fusion-form": "*",
        "neos/symfonymailer": "^1.0",
        "flowpack/jobqueue-common": "^3.4",
        "spomky-labs/otphp": "^11.5",
        "chillerlan/php-qrcode": "^5.0",
        "web-auth/webauthn-lib": "^5.3.5",
        "symfony/serializer": "^6.4 | ^7.0 | ^8.0",
        "symfony/rate-limiter": "^6.4 | ^7.0 | ^8.0",
        "symfony/lock": "^6.4 | ^7.0 | ^8.0"
    },
    "conflict": {
        "sandstorm/neostwofactorauthentication": "*"
    },
    "autoload": {
        "psr-4": {
            "Sandstorm\\BackendUserManagement\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Sandstorm.BackendUserManagement"
        },
        "applied-flow-migrations": [
            "Neos.Twitter.Bootstrap-20161124204912",
            "Neos.Party-20161124225257",
            "Neos.Imagine-20161124231742",
            "Neos.Seo-20170127154600",
            "Neos.Flow-20180415105700",
            "Neos.Neos-20180907103800",
            "Neos.Neos.Ui-20190319094900",
            "Neos.Flow-20190425144900",
            "Neos.Flow-20190515215000",
            "Neos.Flow-20200813181400",
            "Neos.Flow-20201003165200",
            "Neos.Flow-20201109224100",
            "Neos.Flow-20201205172733",
            "Neos.Flow-20201207104500",
            "Neos.Neos-20220318111600",
            "Neos.Flow-20220318174300",
            "Neos.Fusion-20220326120900",
            "Sandstorm.BackendUserManagement-20261028120100"
        ]
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    }
}
